# ====================================================================
# Mentalis — Environment Variables Template
# ====================================================================
# Copy this file to .env.local for local development:
#   cp .env.example .env.local
# ====================================================================

# --------------------------------------------------------------------
# 1. SUPABASE DATABASE CONFIGURATION (Required for Auth & Cloud Sync)
# --------------------------------------------------------------------
# Find these in Supabase Dashboard -> Project Settings -> API
NEXT_PUBLIC_SUPABASE_URL=https://your-project-id.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.your-anon-key-here

# (Optional) Service Role Key for server-side maintenance scripts
# WARNING: Keep this strictly secret! Never expose to client-side.
SUPABASE_SERVICE_ROLE_KEY=your-supabase-service-role-key-here

# --------------------------------------------------------------------
# 2. CRON AUTHORIZATION (Optional)
# --------------------------------------------------------------------
# Secret token to secure /api/cron/daily-pulse against unauthorized calls.
# If configured, requests to the route must supply:
# Authorization: Bearer your-cron-secret
CRON_SECRET=your-random-secure-cron-secret

# --------------------------------------------------------------------
# 3. GOOGLE OAUTH CREDENTIALS (Configured in Supabase Dashboard)
# --------------------------------------------------------------------
# Google OAuth is handled directly through Supabase Auth.
# Add your Google Cloud OAuth Client ID and Secret to:
# Supabase Dashboard -> Authentication -> Providers -> Google
#
# Authorized Redirect URI in Google Cloud Console:
# https://<your-project-id>.supabase.co/auth/v1/callback
